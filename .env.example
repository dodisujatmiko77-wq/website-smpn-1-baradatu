# Salin menjadi .env.local untuk menjalankan di komputer. Di Netlify, isi lewat
# Site configuration > Environment variables (file .env.local tidak ikut di-upload).

# Supabase > Project Settings > API (gunakan anon/publishable key, JANGAN service_role/secret key)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Opsional: domain resmi untuk sitemap, canonical & pratinjau link (default: alamat Netlify)
# VITE_SITE_URL=https://smpn1baradatu.sch.id
